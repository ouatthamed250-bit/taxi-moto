{
  "rules": {
    ".read": false,
    ".write": false,

    "positions": {
      "drivers": {
        ".read": "auth != null",
        "$driverId": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'updatedAt'])"
        }
      },
      "passengers": {
        ".read": "auth != null",
        "$passengerId": {
          ".write": "auth != null && auth.uid === $passengerId",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'updatedAt'])"
        }
      }
    },

    "online": {
      "drivers": {
        ".read": "auth != null",
        "$driverId": {
          ".write": "auth != null && auth.uid === $driverId",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "rideRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null && (!data.exists() || data.child('passengerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['passengerId', 'destination', 'createdAt'])"
      }
    },

    "rideStatus": {
      ".read": "auth != null",
      "$rideId": {
        ".write": "auth != null",
        ".validate": "newData.isString() && newData.val().matches(/^(pending|accepted|arrived|in_progress|completed|cancelled)$/)"
      }
    }
  }
}