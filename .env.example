# ==== Firebase — variables d'environnement (modèle) ====
# 1. Copiez ce fichier en « .env » à la racine du projet.
# 2. Remplissez les valeurs depuis la console Firebase :
#    Paramètres du projet → Vos applications → Configuration du SDK.
# 3. « .env » est ignoré par git : les clés ne sont JAMAIS commitées.
#
# ⚠️ Firebase Web utilise une clé API publique par conception : la sécurité
#    repose sur les règles Firestore / Realtime Database, pas sur le secret
#    de cette clé.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
